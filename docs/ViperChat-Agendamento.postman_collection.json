            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/assignments",
            "description": "ALTERA DADOS. Equipe pode acionar distribuição automática.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team_id\": {{team_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Atribuir agente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/assignments",
            "description": "ALTERA DADOS. Usa sender_id como exemplo de operador atual; isso não atualiza agendamentos existentes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_id\": {{sender_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Remover agente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/assignments",
            "description": "ALTERA DADOS. O agendamento atribuirá seu remetente quando executar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_id\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Remover equipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/assignments",
            "description": "ALTERA DADOS. Independente de remover agente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team_id\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Etiquetas",
      "item": [
        {
          "name": "Criar etiqueta na conta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/labels",
            "description": "ALTERA DADOS. Execute somente se etiqueta não existe. Salva id em label_id. Depende de permissões e recurso habilitado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": {\n    \"title\": \"{{label_title}}\",\n    \"description\": \"Retornos programados\",\n    \"color\": \"#0891B2\",\n    \"show_on_sidebar\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
