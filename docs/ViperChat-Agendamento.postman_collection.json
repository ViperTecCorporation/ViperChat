          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/labels",
            "description": "ALTERA DADOS E SUBSTITUI A LISTA COMPLETA. Acrescente os títulos existentes ao array para preservá-los. No agendamento use label_id; a etiqueta será adicionada ao destino final após conclusão.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"labels\": [\n    \"{{label_title}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Upload e mídia (opcional)",
      "item": [
        {
          "name": "Preparar upload direto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/direct_uploads",
            "description": "Preencha tamanho real e MD5 dos bytes em Base64. O retorno contém signed_id e direct_upload.url/headers. Faça PUT dos bytes nessa URL com os headers retornados, sem token do ViperChat. Após sucesso, preencha attachment_signed_id. Esta coleção não envia bytes automaticamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blob\": {\n    \"filename\": \"{{upload_filename}}\",\n    \"byte_size\": {{upload_byte_size}},\n    \"checksum\": \"{{upload_checksum_base64}}\",\n    \"content_type\": \"{{upload_content_type}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Criar agendamento com anexo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/scheduled_messages",
            "description": "ALTERA DADOS. Alternativa à criação de texto, não etapa adicional. Upload deve estar concluído. Para áudio de voz altere voice_message para true e use blob de áudio compatível.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": {{conversation_id}},\n  \"scheduled_message\": {\n    \"scheduled_at\": \"{{scheduled_at}}\",\n    \"sender_id\": {{sender_id}},\n    \"label_id\": {{label_id}},\n    \"reason\": \"{{reason}}\",\n    \"messages\": [\n      {\n        \"content\": \"{{message_text}}\",\n        \"content_type\": \"text\",\n        \"attachment_blob_ids\": [\n          \"{{attachment_signed_id}}\"\n        ],\n        \"voice_message\": false\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
