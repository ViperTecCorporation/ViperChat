                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/inboxes/{{inbox_id}}/assignable_agents",
            "description": "Execute somente quando necessário. IDs e credenciais devem corresponder à instalação."
          },
          "response": []
