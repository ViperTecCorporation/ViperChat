    {
      "key": "upload_content_type",
      "value": "application/pdf",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('scheduled_at')) {",
          "  const future = new Date(Date.now() + 60 * 60 * 1000);",
          "  const day = future.toISOString().slice(0, 10);",
          "  pm.collectionVariables.set('scheduled_at', future.toISOString());",
          "  pm.collectionVariables.set('date', day);",
          "  pm.collectionVariables.set('start_at', day + 'T00:00:00Z');",
          "  pm.collectionVariables.set('end_at', new Date(Date.parse(day + 'T00:00:00Z') + 86400000).toISOString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Consultas iniciais",
      "item": [
        {
          "name": "Listar caixas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/inboxes",
            "description": "Execute somente quando necessário. IDs e credenciais devem corresponder à instalação."
          },
          "response": []
        },
        {
          "name": "Listar agentes da conta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/agents",
            "description": "Execute somente quando necessário. IDs e credenciais devem corresponder à instalação."
          },
          "response": []
        },
        {
