    {
      "name": "02 - Contato e vínculo",
      "item": [
        {
          "name": "Buscar contato por telefone",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/contacts/search?q={{phone_search}}&page=1",
            "description": "Busca parcial. Confira payload[].phone_number e preencha contact_id manualmente. phone_search deve conter somente os dígitos, sem +."
          },
          "response": []
        },
        {
          "name": "Consultar contato",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/contacts/{{contact_id}}",
            "description": "Execute somente quando necessário. IDs e credenciais devem corresponder à instalação."
          },
          "response": []
        },
        {
          "name": "Criar contato e vínculo com caixa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/contacts",
            "description": "ALTERA DADOS. Buscar antes para evitar duplicidade. Salva payload.contact.id em contact_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{contact_name}}\",\n  \"phone_number\": \"{{phone_number}}\",\n  \"inbox_id\": {{inbox_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  const value = data.payload && data.payload.contact && data.payload.contact.id;",
                  "  if (value !== undefined && value !== null) pm.collectionVariables.set(\"contact_id\", String(value));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Vincular contato existente à caixa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/contacts/{{contact_id}}/contact_inboxes",
            "description": "ALTERA DADOS. Alternativa para contato existente; source_id de WhatsApp é gerado a partir do telefone.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inbox_id\": {{inbox_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Conversa de referência",
      "item": [
        {
          "name": "Listar conversas do contato",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/contacts/{{contact_id}}/conversations",
            "description": "Até 20 conversas visíveis, ordenadas por atividade. Escolha uma da caixa desejada e preencha conversation_id com seu id público."
          },
          "response": []
        },
        {
          "name": "Consultar conversa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}",
            "description": "Execute somente quando necessário. IDs e credenciais devem corresponder à instalação."
          },
          "response": []
        },
        {
          "name": "Criar referência resolvida sem enviar mensagem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations",
            "description": "ALTERA DADOS. Somente se não existe referência. Conversa única pode retornar existente; bot pode alterar status para pending. Salva id em conversation_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact_id\": {{contact_id}},\n  \"inbox_id\": {{inbox_id}},\n  \"status\": \"resolved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  const value = data.id;",
                  "  if (value !== undefined && value !== null) pm.collectionVariables.set(\"conversation_id\", String(value));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolver conversa (opcional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "api_access_token",
                "value": "{{api_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/conversations/{{conversation_id}}/toggle_status",
            "description": "ALTERA O ATENDIMENTO REAL. Não resolve conversa ativa apenas para agendar. Não é necessário resolver ou abrir a referência para criar o agendamento.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Atribuição atual (alternativas)",
