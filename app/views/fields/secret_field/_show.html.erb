<%#
# SecretField Show Partial
%>
<%= javascript_include_tag "secretField" %>

<div data-secret-text="<%= field.data %>" class="cell-data__secret-field">
  <span data-secret-masked="true"></span>
  <button type="button" onclick="toggleSecretField(event)" data-secret-toggler title="<%= t('super_admin.secrets.toggle') %>" aria-label="<%= t('super_admin.secrets.toggle') %>">
    <svg width="20" height="20">
      <use xlink:href="#eye-show" />
    </svg>
  </button>
  <button type="button" onclick="copySecretField(event)" data-secret-copier title="<%= t('super_admin.secrets.copy') %>" aria-label="<%= t('super_admin.secrets.copy') %>">
    <svg width="20" height="20">
      <use xlink:href="#icon-copy" />
    </svg>
  </button>
</div>
