<% content_for(:title) do %>
  <%= t('super_admin.instance_statuses.title') %>
<% end %>
<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>
<section class="main-content__body">
  <table>
  <tr>
    <th><%= t('super_admin.instance_statuses.metric') %></th>
    <th><%= t('super_admin.instance_statuses.value') %></th>
  </tr>
  <% @metrics.each do |key,value| %>
   <tr>
   <td><%= t('super_admin.metrics', default: {}).with_indifferent_access.fetch(key, key) %></td>
   <td><%= t('super_admin.metric_values', default: {}).with_indifferent_access.fetch(value.to_s, value) %></td>
  </tr>
  <% end %>
</table>

</section>
