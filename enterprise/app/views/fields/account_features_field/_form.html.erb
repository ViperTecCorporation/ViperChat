<div class="field-unit__label">
  <%= f.label field.attribute, t('administrate.attributes.account.all_features') %>
</div>
<div class="field-unit__field feature-container">
  <% features_data = field.data %>
  <% if field.resource&.new_record? %>
    <% default_features = SuperAdmin::AccountFeaturesHelper.account_features.each_with_object({}) do |feature, hash| %>
      <% feature_name = feature['name'] || feature[:name] %>
      <% feature_enabled = feature.key?('enabled') ? feature['enabled'] : feature[:enabled] %>
      <% hash[feature_name] = SuperAdmin::AccountFeaturesHelper.boolean_enabled?(feature_enabled) %>
    <% end %>
    <% features_data = features_data.merge(default_features) %>
  <% end %>
  <% regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.filtered_features(features_data).partition { |key_array, _val| !SuperAdmin::AccountFeaturesHelper.account_premium_features.include?(key_array.first) } %>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% regular_features.each do |(feature_key, display_name), val| %>
      <%= render 'super_admin/shared/feature_checkbox', feature_key: feature_key, display_name: display_name, value: val, disabled: false %>
    <% end %>
  </div>
  <hr class="my-8 border-t border-n-weak">
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% premium_features.each do |(feature_key, display_name), val| %>
      <%= render 'super_admin/shared/feature_checkbox', feature_key: feature_key, display_name: display_name, value: val, disabled: ChatwootHub.pricing_plan == 'community' %>
    <% end %>
  </div>
</div>
