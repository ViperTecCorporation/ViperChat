<div class="field-unit__label">
  <%= f.label field.attribute %>
</div>
<div class="field-unit__field">

  <% JSON.parse(field.to_s).each do |key,val| %>
    <div class="mb-4">
      <%= label_tag "account_limits_#{key}", t("super_admin.limits.#{key}.name", default: key) %>
      <%= number_field "account[limits]", key, value: val, title: t("super_admin.limits.#{key}.description", default: '') %>
      <p class="text-xs text-slate-500"><%= t("super_admin.limits.#{key}.description", default: '') %></p>
    </div>
  <% end %>
</div>
